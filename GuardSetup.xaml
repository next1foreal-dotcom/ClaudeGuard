<CheckBox Foreground="{DynamicResource Ink_E7E9EA}" x:Name="SetupUDP" Content="同时阻断浏览器 UDP 直连" Margin="0,4"/>
<TextBlock Text="可能影响浏览器通话；所选客户端的 IPv4 / IPv6 直连都会阻断。" Foreground="{DynamicResource Ink_A2A9AF}" FontSize="11" TextWrapping="Wrap" Margin="20,0,0,12"/>
<Expander Header="高级设置" Margin="0,8"><StackPanel><TextBlock Text="FlClash 配置目录" Margin="0,0,0,6"/><TextBox x:Name="FlClashFolder" Padding="8" Background="{DynamicResource Ink_24282C}" Foreground="{DynamicResource Ink_E7E9EA}" BorderBrush="{DynamicResource Ink_363A3E}"/><TextBlock Text="目前适配 FlClash。检测到其他代理时请先确认 HTTP 端口，并使用 FlClash 完成分流配置。" TextWrapping="Wrap" Foreground="{DynamicResource Ink_A2A9AF}" FontSize="11" Margin="0,8,0,0"/></StackPanel></Expander>
</StackPanel>
<StackPanel x:Name="ReviewSection" Visibility="Collapsed">
<Border CornerRadius="12" Background="{DynamicResource Ink_132F353A}" BorderBrush="{DynamicResource Ink_363A3E}" BorderThickness="1" Padding="18" Margin="0,0,0,16"><StackPanel><TextBlock Text="当前代理出口" Foreground="{DynamicResource Ink_A2A9AF}"/><TextBlock x:Name="ReviewIP" FontSize="28" FontWeight="SemiBold" Margin="0,8"/><TextBlock x:Name="ReviewCountry" Margin="0,0,0,12"/><TextBlock x:Name="ReviewNode" TextWrapping="Wrap"/><TextBlock x:Name="ReviewProxy" Foreground="{DynamicResource Ink_A2A9AF}" FontSize="12" Margin="0,8,0,0"/></StackPanel></Border>
<TextBlock x:Name="ReviewPrograms" TextWrapping="Wrap" Margin="0,0,0,16"/>
<CheckBox Foreground="{DynamicResource Ink_E7E9EA}" x:Name="ConfirmExit"><TextBlock Foreground="{DynamicResource Ink_E7E9EA}" Text="我确认这是要使用的出口和节点" FontWeight="SemiBold" TextWrapping="Wrap"/></CheckBox>
<TextBlock Text="启用后请通过面板启动所选程序。未从面板启动的已有进程可能因直连阻断而无法联网。" Foreground="{DynamicResource Ink_A2A9AF}" FontSize="12" TextWrapping="Wrap" Margin="20,8,0,0"/>
</StackPanel>
<TextBlock x:Name="SetupError" Visibility="Collapsed" Foreground="{DynamicResource Ink_FF757C}" TextWrapping="Wrap" Margin="0,14,0,0"/>
</StackPanel></ScrollViewer>
<Border Grid.Row="2" BorderBrush="{DynamicResource Ink_363A3E}" BorderThickness="0,1,0,0" Padding="24,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="1.3*"/></Grid.ColumnDefinitions><Button x:Name="SetupBack" Content="重新扫描" Height="38"/><Button x:Name="SetupNext" Grid.Column="2" Content="检测出口" Height="38" IsEnabled="False" Background="{DynamicResource Ink_183127}" Foreground="{DynamicResource Ink_68DA9C}" FontWeight="SemiBold"/></Grid></Border>
</Grid></Border></Window>